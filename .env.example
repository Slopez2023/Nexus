# NEXUS Trading System Environment Configuration
# Copy this file to .env and update with your actual values

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nexus_trading
DB_USER=nexus_user
DB_PASSWORD=your_secure_db_password_here
DB_MIN_CONNECTIONS=1
DB_MAX_CONNECTIONS=10

# API Keys (get from respective services)
MASSIVE_API_KEY=your_polygon_api_key_here
OPENROUTER_API_KEY=your_openrouter_key_here
DEEPSEEK_API_KEY=your_deepseek_key_here
COINGECKO_API_KEY=your_coingecko_key_here

# Logging Configuration
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_JSON=false
CONSOLE_LOG_LEVEL=INFO

# Backup Configuration
BACKUP_DIR=backups
BACKUP_RETENTION_DAYS=30

# Redis Configuration (for future use)
REDIS_URL=redis://localhost:6379

# Application Settings
APP_ENV=development
DEBUG=false

# Warehouse API Configuration (Market Data Warehouse)
WAREHOUSE_API_URL=http://localhost:8000
WAREHOUSE_API_ENABLED=false
WAREHOUSE_API_PRIMARY=false
WAREHOUSE_API_TIMEOUT=30
WAREHOUSE_API_MAX_CONNECTIONS=100
WAREHOUSE_API_RETRY_ATTEMPTS=3
WAREHOUSE_API_RETRY_BACKOFF_MS=100
WAREHOUSE_API_RETRY_MAX_BACKOFF_MS=30000
WAREHOUSE_API_CB_FAILURE_THRESHOLD=5
WAREHOUSE_API_CB_TIMEOUT=60

# External Services
# Add other API keys as needed
