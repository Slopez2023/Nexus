# 🔑 NEXUS Environment Configuration
# Copy this file to .env and fill in your actual API keys

# ============================================================================
# AI MODEL PROVIDERS (At least one required)
# ============================================================================

# Anthropic Claude (Recommended for trading analysis)
ANTHROPIC_KEY=your_anthropic_api_key_here

# OpenAI GPT Models
OPENAI_KEY=your_openai_api_key_here

# DeepSeek (Cost-effective reasoning)
DEEPSEEK_KEY=your_deepseek_api_key_here

# Groq (Fast inference)
GROQ_API_KEY=your_groq_api_key_here

# Google Gemini
GEMINI_KEY=your_gemini_api_key_here

# ============================================================================
# MARKET DATA PROVIDERS
# ============================================================================

# BirdEye (Solana token data - Required for Solana trading)
BIRDEYE_API_KEY=your_birdeye_api_key_here

# CoinGecko (General crypto data)
COINGECKO_API_KEY=your_coingecko_api_key_here

# ============================================================================
# BLOCKCHAIN CONNECTIONS
# ============================================================================

# Solana Private Key (Required for live Solana trading)
SOLANA_PRIVATE_KEY=your_solana_private_key_here

# RPC Endpoint (Optional - defaults to public endpoints)
RPC_ENDPOINT=https://api.mainnet-beta.solana.com

# ============================================================================
# TRADING CONFIGURATION
# ============================================================================

# Trading Mode (true for paper trading, false for live)
PAPER_TRADING=true

# Exchange Selection (solana, hyperliquid)
EXCHANGE=solana

# ============================================================================
# SYSTEM CONFIGURATION
# ============================================================================

# Data Cache Settings
DATA_CACHE_HOURS=1

# Default AI Model for Analysis
DEFAULT_AI_MODEL=claude-3-haiku-20240307

# AI Temperature (0.0 = deterministic, 1.0 = creative)
AI_TEMPERATURE=0.7

# ============================================================================
# HOW TO GET API KEYS
# ============================================================================

# Anthropic Claude: https://console.anthropic.com/
# - Sign up for account
# - Create API key in dashboard
# - Recommended for trading analysis

# OpenAI: https://platform.openai.com/api-keys
# - Create account
# - Generate API key
# - Good for general AI tasks

# DeepSeek: https://platform.deepseek.com/
# - Register account
# - Get API key
# - Very cost-effective for reasoning tasks

# Groq: https://console.groq.com/
# - Sign up
# - Create API key
# - Fast inference, good for quick analysis

# BirdEye: https://birdeye.so/
# - Create account
# - Get API key from dashboard
# - Required for Solana market data

# CoinGecko: https://www.coingecko.com/en/api
# - Free API key available
# - Good for general crypto information

# ============================================================================
# SECURITY NOTES
# ============================================================================

# 🔒 NEVER commit your .env file to version control
# 🔒 NEVER share your API keys publicly
# 🔒 NEVER use the same keys across multiple projects
# 🔒 Rotate keys periodically for security

# Your .env file is in .gitignore for your protection</content>
</xai:function_call">  

